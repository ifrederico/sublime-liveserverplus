// LiveServerPlus.sublime-settings
{
    // Changes apply as soon as you save this file; no manual restart needed.
    // While the server is running, changing "host", "port", "useLocalIp",
    // "useWebExt", "liveReload", "ignoreFiles", "ignoreDirs", "maxThreads" or
    // "maxWatchedDirs" restarts it automatically. All other settings take
    // effect immediately without a restart.

    // ==========================================
    // Basic Server Settings
    // ==========================================

    // Hostname/IP where the server runs. Keep 127.0.0.1 for local-only serving.
    // For phone/tablet QR preview, use the "Enable LAN Access" command instead of editing this.
    "host": "127.0.0.1",

    // Port number for the server. Use 0 to select a random free port.
    "port": 5500,

    // Browser to launch on start ("chrome", "firefox", "safari", "edge", "brave").
    // Leave empty for the system default.
    "customBrowser": "",

    // Automatically open a browser when the server starts.
    "openBrowser": true,

    // Show informational status messages in Sublime's status bar.
    "showInfoMessages": true,

    // Verify HTML tags and warn when live reload injection fails.
    "verifyTags": true,

    // Enable LAN access for phones/tablets and QR preview.
    // When true, the server listens on your local network and QR codes use your LAN IP.
    // Only enable this on trusted networks.
    "useLocalIp": false,

    // Use the browser extension workflow instead of script injection.
    "useWebExt": false,

    // ==========================================
    // Live Reload
    // ==========================================

    // Enable Sublime-based live reload (disables Watchdog when true).
    "liveReload": false,

    // Force full page reloads on every change (disables CSS-only hot reload).
    "fullReload": false,

    // Debounce delay (ms) for reload events.
    // When "liveReload" is true, this debounces the reload broadcast triggered by buffer modifications.
    // The dev server serves the in-progress buffer snapshot, so your file is not saved until you save it.
    "wait": 100,

    // Paths the file watcher and Sublime live reload ignore: changes to
    // matching files do not trigger a reload. Uses .gitignore-style globs:
    // "**" spans any number of directories, "*" stays within one path segment,
    // and a bare name such as "dist" also covers everything inside a directory
    // of that name. This does not affect what the server serves. Dotfiles and
    // dot-folders (.env, .git/) are never served, regardless of this setting.
    "ignoreFiles": [
        "**/node_modules/**",
        "**/.git/**",
        "**/__pycache__/**"
    ],

    // Maximum concurrent request handlers (higher handles more reload burst traffic).
    "maxThreads": 64,

    // Maximum number of directories Watchdog will monitor (increase for large monorepos).
    "maxWatchedDirs": 50,

    // ==========================================
    // Logging & UI
    // ==========================================

    // Enable console logging for troubleshooting.
    "logging": false,

    // Show server status text in Sublime's status bar.
    "showOnStatusbar": true,

    // ==========================================
    // Markdown Preview
    // ==========================================

    // Render Markdown files as GitHub-style HTML previews.
    "renderMarkdownPreview": true,

    // Control Markdown scroll sync: "editor" (default), "sync", or false to disable.
    "markdownScrollSync": "editor",

    // The three options below load assets that ship with the plugin — nothing
    // is fetched from the internet, so they work offline and over LAN/QR.
    // They are off by default because each one adds JavaScript that the preview
    // re-parses on every reload; enable only what you use.

    // Highlight fenced code blocks (highlight.js, ~125 KB).
    "markdownSyntaxHighlighting": false,

    // Render $...$ and $$...$$ math (KaTeX, ~570 KB including fonts).
    "markdownMath": false,

    // Render ```mermaid blocks as diagrams (Mermaid, ~3.5 MB — noticeably
    // heavier than the others; only worth enabling if you use diagrams).
    "markdownMermaid": false
}
